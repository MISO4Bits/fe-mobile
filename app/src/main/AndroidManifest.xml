<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber si hay red antes de cotizar o enviar (BITS-217). No se le pide al usuario. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foto de la cedula (BITS-275). Sin camara, el cliente elige de la galeria. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_de_datos"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Solventa">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Solventa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
