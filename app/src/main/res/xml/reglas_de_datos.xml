<?xml version="1.0" encoding="utf-8"?>
<!-- Nada del cliente sale del dispositivo por copia de seguridad: la app
     maneja datos financieros y de identidad bajo consentimiento. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
